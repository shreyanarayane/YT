# All customer, billing, and content records are stored in Supabase.
APP_ENV=development

# Supabase Auth and PostgREST
SUPABASE_URL=https://your-project-ref.supabase.co
# Safe to pass to Flutter via --dart-define. Do not use a service-role key.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxx
# Server-only. Required by FastAPI after the Supabase Auth migration.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret
# Set an administrator's profile role to `admin` from the Supabase SQL Editor
# after that person has registered through Supabase Auth. Do not store an
# administrator password in this file.

# Razorpay TEST MODE keys only while developing.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-test-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret

# Turn on only after Razorpay webhooks are configured and tested.
BILLING_ENFORCE_SUBSCRIPTIONS=false

CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# YouTube OAuth (Web application client). Store the client JSON as a Render
# secret/env value; do not commit client_secret.json or expose client_secret.
GOOGLE_CLIENT_SECRET_JSON={"web":{"client_id":"...","client_secret":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}}
GOOGLE_OAUTH_REDIRECT_URI=https://your-api.onrender.com/api/youtube/callback
FRONTEND_URL=https://your-frontend.vercel.app
# Generate a Fernet key and a separate random state-signing secret; keep stable.
YOUTUBE_TOKEN_ENCRYPTION_KEY=replace-with-generated-fernet-key
YOUTUBE_OAUTH_STATE_SECRET=replace-with-at-least-32-random-characters
